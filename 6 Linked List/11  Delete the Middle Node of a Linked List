class Solution(object):
    def deleteMiddle(self, head):
        count=0
        temp=head
        while temp:
            temp=temp.next
            count+=1
        if count==1:
            return None
        mid=count//2
        prev=head
        temp=head
        count=0
        while count<mid:
            prev=temp
            temp=temp.next
            count+=1
        prev.next=temp.next
        temp.next=None
        return head

            




