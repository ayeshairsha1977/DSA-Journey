class Solution(object):
    
    def reverseBetween(self, head, left, right):
        if right==left:
            return head
        if left==1:
            start=None
            curr=head
        else:
            count=1
            start=head
            while count<left-1:
                start=start.next
                count+=1
            curr=start.next
        ftemp=curr

        count=0 
        pre=None
        while count<(right-left+1):
            temp=curr.next
            curr.next=pre
            pre=curr
            curr=temp
            count+=1
        if start:
            start.next=pre
        else:
            head=pre
        ftemp.next=curr
        return head
        


        
        
        
        