class Solution(object):
    def isPalindrome(self, head):
        s=""
        temp=head
        while temp:
            s+=str(temp.val)
            temp=temp.next
        l,e=0,len(s)-1
        while l<=e:
            if not s[l]==s[e]:
                return False
            l+=1
            e-=1
        return True