# Definition for singly-linked list.
# class ListNode(object):
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution(object):
    def modifiedList(self, nums, head):
        temp=head
        prev=None
        nums=set(nums)
        while temp :
            if temp.val in nums:
                if prev:
                    dummy=prev.next
                    prev.next=temp.next
                    temp=temp.next
                    dummy.next=None
                else:
                    dummy=head
                    head=head.next
                    temp=head
                    dummy.next=None
            else:
                prev=temp
                temp=temp.next
        return head
        """
        :type nums: List[int]
        :type head: Optional[ListNode]
        :rtype: Optional[ListNode]
        """
        