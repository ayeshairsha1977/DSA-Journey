class MyCircularQueue(object):

    def __init__(self, k):
        self.k=k
        self.queue=[0]*self.k
        self.rear=0
        self.front=-1
        """
        :type k: int
        """
        

    def enQueue(self, value):
        if self.isFull():
            return False
        if self.front==-1:
            self.front=0
        self.queue[self.rear]=value
        self.rear=(self.rear+1)%self.k
        return True
        

        """
        :type value: int
        :rtype: bool
        """
        

    def deQueue(self):
        if self.isEmpty():
            return False
        self.front=(self.front+1)%self.k
        if self.rear==self.front:
            self.front=-1
            self.rear=0
        return True

        
        """
        :rtype: bool
        """
        

    def Front(self):
        if self.isEmpty():
            return -1
        return self.queue[self.front]
        """
        :rtype: int
        """
        

    def Rear(self):
        if self.isEmpty():
            return -1
        return self.queue[self.rear-1]
        """
        :rtype: int
        """
        

    def isEmpty(self):
        return self.front==-1
        """
        :rtype: bool
        """
        

    def isFull(self):
        return self.rear==self.front
        """
        :rtype: bool
        """
        


