class MyQueue(object):

    def __init__(self):
        self.stack1=[]
        self.stack2=[]

    def push(self, x):
        self.stack1.append(x)
        """
        :type x: int
        :rtype: None
        """

    def pop(self): 
        if len(self.stack2)==0:
            while self.stack1:
                self.stack2.append(self.stack1.pop())
        val=self.stack2.pop()
        return val
        """
        :rtype: int
        """

    def peek(self):
        if len(self.stack2)==0:
            while self.stack1:
                self.stack2.append(self.stack1.pop())
        return self.stack2[-1]
        """
        :rtype: int
        """
        

    def empty(self):
        return len(self.stack1)==0 and len(self.stack2)==0
        """
        :rtype: bool
        """
        


