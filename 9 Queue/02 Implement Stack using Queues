class MyStack(object):

    def __init__(self):
        self.q1=[]
        self.q2=[]

    def push(self, x):
        self.q1.append(x)
        """
        :type x: int
        :rtype: None
        """
        

    def pop(self):
        while len(self.q1)>1:
            self.q2.append(self.q1[0])
            self.q1=self.q1[1:]
        val=self.q1[0]
        self.q1=[]
        while self.q2:
            self.q1.append(self.q2[0])
            self.q2=self.q2[1:]
        return val

    def top(self):
        while len(self.q1)>1:
            self.q2.append(self.q1[0])
            self.q1=self.q1[1:]
        val=self.q1[0]
        self.q2.append(self.q1[0])
        self.q1=[]
        while self.q2:
            self.q1.append(self.q2[0])
            self.q2=self.q2[1:]
        return val

        

    def empty(self):
        return len(self.q1)==0
        """
        :rtype: bool
        """
        


