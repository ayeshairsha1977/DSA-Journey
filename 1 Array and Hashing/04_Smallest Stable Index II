class Solution(object):
    def firstStableIndex(self, nums, k):
        n=len(nums)
        prefmax=[0]*n
        prefmax[0]=nums[0]
        for i in range(1,n):
            prefmax[i]=max(prefmax[i-1],nums[i])
        prefmin=[0]*n
        prefmin[n-1]=nums[n-1]
        for i in range(n-2,-1,-1):
            prefmin[i]=min(prefmin[i+1],nums[i])
        for i in range(n):
            if (prefmax[i]-prefmin[i])<=k:
                return i
        return -1
        
        """
        :type nums: List[int]
        :type k: int
        :rtype: int
        """
        