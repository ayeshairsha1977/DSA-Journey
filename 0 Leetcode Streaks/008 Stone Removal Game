class Solution(object):
    def canAliceWin(self, n):
        alice=False
        i=10
        while n>0:
            if not alice and n-i>=0:
                n-=i
                alice=True
            elif n-i>=0:
                n-=i
                alice=False
            else:
                break
            i-=1
        return alice
        """
        :type n: int
        :rtype: bool
        """
        