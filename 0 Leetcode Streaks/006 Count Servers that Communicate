class Solution(object):
    def countServers(self, grid):
        r_c,c_c=[0]*len(grid),[0]*len(grid[0])
        ans=0
        for i in range(len(grid)):
            r_c[i]=sum(grid[i])
        for j in range(len(grid[0])):
            for i in range(len(grid)):
                c_c[j] += grid[i][j]
       
        for i in range(len(grid)):
            for j in range(len(grid[0])):
                if grid[i][j]==1 and (r_c[i]>1 or c_c[j]>1):
                    ans+=1
        return ans

        """
        :type grid: List[List[int]]
        :rtype: int
        """
        