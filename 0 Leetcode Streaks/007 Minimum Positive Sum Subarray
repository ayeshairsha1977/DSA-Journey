class Solution(object):
    def minimumSumSubarray(self, nums, l, r):
        ans=float('inf')
        for i in range(len(nums)):
            su=nums[i]
            if l<=1<=r and su>0:
                ans=min(ans,su)
            for j in range(i+1,len(nums)):
                su+=nums[j]
                leng=j-i+1
                if l<=leng<=r and su>0:
                    ans=min(ans,su)
        return ans if ans!=float('inf') else -1
        """
        :type nums: List[int]
        :type l: int
        :type r: int
        :rtype: int
        """
        