#Clean String Parsing with HashMap | Bracket Pair Evaluation
class Solution(object):
    def evaluate(self, s, knowledge):
        knowledge=dict(knowledge)
        end=0
        result=[]
        while end<len(s):
            if s[end]=='(':
                end+=1
                key=""
                while s[end]!=')':
                    key+=s[end]
                    end+=1
                result.append(knowledge.get(key,"?"))
                end+=1
            else:
                result.append(s[end])
                end+=1
        return ''.join(result)

                

                    

        """
        :type s: str
        :type knowledge: List[List[str]]
        :rtype: str
        """
        