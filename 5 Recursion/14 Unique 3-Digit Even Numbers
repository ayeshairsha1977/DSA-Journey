class Solution(object):
    def back(self,digits,s,count,seen):
        if len(s)==3:
            if int(s)%2==0:
                count[0]+=1
            return
        for i in range(len(seen)):
            if len(s)==0 and digits[i]==0:
                continue
            if i>0 and digits[i]==digits[i-1] and  not seen[i-1]:
                continue
            if not seen[i]:
                seen[i]=True
                self.back(digits,s+str(digits[i]),count,seen)
                seen[i]=False
    def totalNumbers(self, digits):
        digits.sort()
        count=[0]
        seen=[False]*len(digits)
        self.back(digits,"",count,seen)
        return count[0]

        """
        :type digits: List[int]
        :rtype: int
        """
        