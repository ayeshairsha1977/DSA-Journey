class Solution(object):
    def gen(self,nums,curr,i,l):
        if i==len(nums):
            l.append(list(curr))
            return 
        curr.append(nums[i])
        self.gen(nums,curr,i+1,l)
        curr.pop()
        while i+1<len(nums) and nums[i]==nums[i+1]:
            i+=1
        self.gen(nums,curr,i+1,l)
    def subsetsWithDup(self, nums):
        l=[]
        nums.sort()
        self.gen(nums,[],0,l)
        return l
        
        