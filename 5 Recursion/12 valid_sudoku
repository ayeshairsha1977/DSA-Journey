class Solution(object):
    def check(self,n,arr,row,col):
        #coumns
        value=arr[row][col]
        if value=='.':
            return True
        for i in range(row+1,n):
            if arr[i][col]==value:
                return False
        #row
        for i in range(col+1,n):
            if arr[row][i]==value:
                return False
        # rem
        startrow=(row//3)*3
        startcol=(col//3)*3
        for r in range(startrow,startrow+3):
            for c in range(startcol,startcol+3):
                if (r>row or (r==row and c>col)):
                    if(arr[row][col]==value):
                        return False
        return True    
    def gen(self,n,board,row,col):
        if row==9:
            return True
        if col==9:
            return self.gen(n,board,row+1,0)
        if not self.check(n,board,row,col):
            return False
        return self.gen(n,board,row,col+1)
    def isValidSudoku(self, board):
        return self.gen(len(board),board,0,0)
        


        
        