class Solution(object):
    def getSmallestString(self, s):
        temp=s
        f,e=0,1
        if len(s)==1:
            return s
        while e<len(s):
            if int(s[f]) % 2 == int(s[e]) % 2:
                # temp=s[f]
                s=s[:f]+s[e]+s[f]+s[e+1:]
                if s<temp:
                    break
                else:
                    s=temp
            f+=1
            e+=1
        return s