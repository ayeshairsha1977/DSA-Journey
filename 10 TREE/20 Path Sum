# Definition for a binary tree node.
# class TreeNode(object):
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution(object):
    def hasPathSum(self, root, targetSum):
        if root is None:
            return False

        def path(root,curr):
            curr+=root.val
            if root.left is None and root.right is None:
                return curr==targetSum
            if root.left:
                if path(root.left,curr):
                    return True
            if root.right:
                if path(root.right,curr):
                    return True
            return False
        
            
        return path(root,0)
        
        """
        :type root: Optional[TreeNode]
        :type targetSum: int
        :rtype: bool
        """
        