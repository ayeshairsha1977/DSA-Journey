class Solution(object):
    def getDirections(self, root, startValue, destValue):
        def dfs(root,target,path):
            if root is None:
                return None
            if root.val==target:
                return path
            left=dfs(root.left,target,path+"L")
            if left is not None:
                return left
            right=dfs(root.right,target,path+"R")
            return right
        self.start=dfs(root,startValue,"")
        self.end=dfs(root,destValue,"")
        j=0
        while j<min(len(self.start),len(self.end)) and self.start[j]==self.end[j]:
            j+=1
        return "U"*(len(self.start)-j)+self.end[j:]
            

        
        
