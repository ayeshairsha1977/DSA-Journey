# Definition for a binary tree node.
# class TreeNode(object):
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution(object):
    def getDirections(self, root, startValue, destValue):
        def lca(node):
            if node is None:
                return None
            if node.val==startValue or node.val==destValue:
                return node
            left=lca(node.left)
            right=lca(node.right)
            if left and right:
                return node
            return left or right
        ancestor=lca(root)
        def path(root,target,p):
            if root is None:
                return False
            if root.val==target:
                return True
            p.append("L")
            if path(root.left,target,p):
                return True
            p.pop()
            p.append("R")
            if path(root.right,target,p):
                return True
            p.pop()
            return False
        start=[]
        end=[]
        path(ancestor,startValue,start)
        path(ancestor,destValue,end)
        return "U"*len(start)+ "".join(end)

        """
        :type root: Optional[TreeNode]
        :type startValue: int
        :type destValue: int
        :rtype: str
        """
        