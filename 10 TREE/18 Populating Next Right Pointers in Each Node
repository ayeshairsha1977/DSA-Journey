from collections import deque
class Solution(object):
    def connect(self, root):
        if root is None:
            return None
        q=deque([root])
        while q:
            n=len(q)
            for _ in range(n):
                node=q.popleft()
                if node.left:
                    q.append(node.left)
                if node.right:
                    q.append(node.right)
                if _==n-1:
                    node.next=None
                else:
                    node.next=q[0]
        return root


        """
        :type root: Node
        :rtype: Node
