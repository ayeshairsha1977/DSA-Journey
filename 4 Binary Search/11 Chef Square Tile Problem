#code chef problem
# Write your code here
n=int(input())
arr=list(map(int,input().split()))[:n]
s=sum(arr)
l,r=1,s
found=False
while l<=r:
    mid=l+(r-l)//2
    if mid*mid==s:
        found=True
        break
    elif mid*mid<s:
        l=mid+1
    else:
        r=mid-1
print("Yes" if found else "No")