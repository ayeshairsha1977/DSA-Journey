class Solution(object):
    def scoreOfParentheses(self, s):
        stack=[0]
        for ch in s:
            if ch=='(':
                stack.append(0)
            else:
                ele=stack.pop()
                m=max(1,ele*2)
                stack[-1]+=m
        return stack[0]
                
        """
        :type s: str
        :rtype: int
        """
        