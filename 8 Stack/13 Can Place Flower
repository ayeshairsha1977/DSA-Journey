class Solution(object):
    def asteroidCollision(self, asteroids):
        stack=[]
        n=len(asteroids)
        for ast in asteroids:
            alive=True
            while stack and stack[-1]>0 and ast<0:
                if abs(ast)>stack[-1]:
                    stack.pop()
                elif abs(ast)==stack[-1]:
                    stack.pop()
                    alive=False
                    break
                else:
                    alive=False
                    break

            if alive:
                stack.append(ast)
        return stack    
        """
        :type asteroids: List[int]
        :rtype: List[int]
        """
        