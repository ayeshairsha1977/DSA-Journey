class Solution(object):
    def nextGreaterElement(self, n):
        digits=list(str(n))
        n=len(digits)
        i=n-2
        while i>=0 and digits[i]>=digits[i+1]:
            i-=1
        if i<0:
            return -1
        j=n-1
        while digits[j]<=digits[i]:
            j-=1
        digits[i],digits[j]=digits[j],digits[i]
        digits[i+1:]=sorted(digits[i+1:])
        result=int("".join(digits))
        if result> ((2**31)-1):
            return -1
        return result

        """
        :type n: int
        :rtype: int
        """
        