class Solution(object):
    def evalRPN(self, tokens):
        stack=[]
        for i in tokens:
            if i in "+-*/":
                a=int(stack.pop())
                b=int(stack.pop())
                ma=-1
                if i=='+':
                    ma=b+a
                elif i=='-':
                    ma=b-a
                elif i=='*':
                    ma=b*a
                else:
                    ma=int(float(b)/a)
                stack.append(ma)

            else:
                stack.append(i)
        return int(stack[0])

        """
        :type tokens: List[str]
        :rtype: int
        """
        