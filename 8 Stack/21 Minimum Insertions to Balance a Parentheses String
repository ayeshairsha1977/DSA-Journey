class Solution(object):
    def minInsertions(self, s):
        count,need=0,0
        for ch in s:
            if ch=='(':
                if need%2==1:
                    count+=1
                    need-=1
                need+=2
            else:
                need-=1
                if need<0:
                    count+=1
                    need=1
        return need+count

        """
        :type s: str
        :rtype: int
        """
        